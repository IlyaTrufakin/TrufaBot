<Window x:Class="TrufaBot.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrufaBot — Домашний медиа-сервер" Height="840" Width="1260"
        WindowStartupLocation="CenterScreen" Background="#181825" Foreground="#FFFFFF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#11111B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#585B70"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#11111B"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="BorderBrush" Value="#585B70"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="RowBackground" Value="#1E1E2E"/>
            <Setter Property="AlternatingRowBackground" Value="#252538"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#313244"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <Border Grid.Row="0" Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Токен Telegram бота:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding BotToken, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center" Margin="0,0,15,0"/>
                
                <Button Grid.Column="2" Content="▶ Запустить / Остановить бота" 
                         Command="{Binding ToggleBotCommand}" Padding="15,8" FontWeight="Bold" Margin="0,0,10,0"
                         Background="#89B4FA" Foreground="#11111B"/>
                
                <Button Grid.Column="3" Command="{Binding SyncAllSourcesCommand}" 
                        Padding="15,8" Foreground="#11111B" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#A6E3A1"/>
                            <Setter Property="Content" Value="🔄 Синхронизировать NAS"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                    <Setter Property="Background" Value="#F9E2AF"/>
                                    <Setter Property="Content" Value="⏳ Идет сканирование..."/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Основные вкладки -->
        <TabControl Grid.Row="1" Background="#1E1E2E" BorderBrush="#313244">
            
            <!-- Вкладка 1: Журнал событий и Аудит -->
            <TabItem Header="📊 Журнал событий">
                <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" 
                          IsReadOnly="True" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="90"/>
                        <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="90"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="110"/>
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding UserIdentifier}" Width="130"/>
                        <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Вкладка 2: Источники файлов -->
            <TabItem Header="📁 Источники (NAS / Диски)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#313244" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Имя источника:" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewSourceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <TextBlock Grid.Column="2" Text="Путь (D:\ или \\NAS\share):" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding NewSourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <Button Grid.Column="4" Content="➕ Добавить источник" Command="{Binding AddSourceCommand}" 
                                    Padding="15,6" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Sources}" AutoGenerateColumns="False" 
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="Путь (Локальный / UNC)" Binding="{Binding RootPath}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Сетевой (NAS)" Binding="{Binding IsNetworkShare}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Включен" Binding="{Binding IsEnabled}" Width="80"/>
                            <DataGridTextColumn Header="Посл. скан" Binding="{Binding LastScannedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="150"/>
                            <DataGridTemplateColumn Header="Действия" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Вкл/Выкл" 
                                                    Command="{Binding DataContext.ToggleSourceEnabledCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" 
                                                    Padding="8,2" Margin="0,0,6,0" Background="#F9E2AF" Foreground="#11111B"/>
                                            <Button Content="🗑 Удалить" 
                                                    Command="{Binding DataContext.DeleteSourceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" 
                                                    Padding="8,2" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Пользователи и Права Доступа -->
            <TabItem Header="👥 Пользователи и Доступ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#313244" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Telegram ID:" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewTelegramUserId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <TextBlock Grid.Column="2" Text="Имя:" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding NewUserDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <Button Grid.Column="5" Content="➕ Добавить пользователя" Command="{Binding AddUserCommand}" 
                                    Padding="15,6" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="480"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1E1E2E" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="👥 Список пользователей (выберите для настройки):" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,8"/>
                                
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Telegram ID" Binding="{Binding TelegramUserId}" Width="110"/>
                                        <DataGridTextColumn Header="Имя" Binding="{Binding DisplayName}" Width="120"/>
                                        <DataGridCheckBoxColumn Header="Админ" Binding="{Binding IsAdmin}" Width="65"/>
                                        <DataGridCheckBoxColumn Header="Актив" Binding="{Binding IsActive}" Width="60"/>
                                        <DataGridTemplateColumn Header="Действия" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="⭐" ToolTip="Переключить права администратора"
                                                                Command="{Binding DataContext.ToggleUserAdminCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" 
                                                                Padding="5,1" Margin="0,0,3,0" Background="#F9E2AF" Foreground="#11111B"/>
                                                        <Button Content="Вкл/Выкл" 
                                                                Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" 
                                                                Padding="5,1" Margin="0,0,3,0" Background="#A6E3A1" Foreground="#11111B"/>
                                                        <Button Content="🗑" ToolTip="Удалить"
                                                                Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" 
                                                                Padding="5,1" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#1E1E2E" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,0,0,8">
                                    <Run Text="🔐 Права доступа для: "/>
                                    <Run Text="{Binding SelectedUser.DisplayName, FallbackValue='(не выбран)'}" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                </TextBlock>

                                <Border Grid.Row="1" Background="#313244" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Источник:" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedPermissionSource}"
                                                  DisplayMemberPath="Name" Margin="0,0,10,0"/>

                                        <TextBlock Grid.Column="2" Text="Папка:" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                        <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableFoldersForSelectedSource}" 
                                                  SelectedItem="{Binding SelectedFolderToGrant}" Margin="0,0,10,0"/>

                                        <Button Grid.Column="4" Content="[+] Разрешить" Command="{Binding AddPermissionForSelectedUserCommand}"
                                                Padding="10,4" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold"/>
                                    </Grid>
                                </Border>

                                <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedUserPermissions}" AutoGenerateColumns="False" 
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Источник (Диск/NAS)" Binding="{Binding StorageSource.Name}" Width="160"/>
                                        <DataGridTextColumn Header="Разрешенная папка" Binding="{Binding AllowedRelativePath}" Width="*"/>
                                        <DataGridTemplateColumn Header="Действие" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑 Отозвать" 
                                                            Command="{Binding DataContext.DeletePermissionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" 
                                                            Padding="6,2" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка 4: Локальный ИИ (LM Studio) -->
            <TabItem Header="🤖 Локальный ИИ (LM Studio)">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель подключения к LM Studio -->
                    <Border Grid.Row="0" Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Адрес LM Studio:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding AiServerUrl, UpdateSourceTrigger=PropertyChanged}" 
                                         VerticalAlignment="Center" Margin="0,0,15,0"/>

                                <Button Grid.Column="2" Content="🔌 Проверить связь с LM Studio" 
                                        Command="{Binding TestAiConnectionCommand}" Padding="15,6" FontWeight="Bold" Margin="0,0,15,0"
                                        Background="#89B4FA" Foreground="#11111B"/>

                                <CheckBox Grid.Column="3" Content="Включить обработку ИИ" IsChecked="{Binding IsAiEnabled}" 
                                          VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,15,0"/>
                            </Grid>

                            <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                                <TextBlock Text="{Binding AiConnectionStatus}" Foreground="#A6E3A1" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Панель управления индексацией и статистика -->
                    <Border Grid.Row="1" Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Статистика -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Всего файлов в архиве:" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock Text="{Binding AiTotalPhotos}" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Обработано ИИ:" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock Text="{Binding AiProcessedPhotos}" FontWeight="Bold" FontSize="18" Foreground="#A6E3A1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ожидает обработки:" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock Text="{Binding AiPendingPhotos}" FontWeight="Bold" FontSize="18" Foreground="#F9E2AF"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="▶ Запустить авто-тегирование" Command="{Binding StartAiIndexingCommand}" 
                                            Padding="15,8" Margin="0,0,10,0" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold"/>
                                    <Button Content="⏹ Остановить" Command="{Binding StopAiIndexingCommand}" 
                                            Padding="15,8" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Прогресс бар -->
                            <ProgressBar Grid.Row="1" Height="10" Value="{Binding AiIndexingProgress}" Maximum="100" 
                                         Background="#11111B" Foreground="#89B4FA" Margin="0,0,0,8"/>

                            <!-- Текстовый статус -->
                            <TextBlock Grid.Row="2" Text="{Binding AiIndexingStatusText}" Foreground="#CDD6F4" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- Недавно описанные фото -->
                    <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="✨ Недавно обработанные нейросетью файлы:" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,8"/>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding RecentAiProcessedItems}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="160"/>
                                    <DataGridTextColumn Header="Описание ИИ" Binding="{Binding AIDescription}" Width="*"/>
                                    <DataGridTextColumn Header="Теги" Binding="{Binding AITags}" Width="220"/>
                                    <DataGridTextColumn Header="Дата обработки" Binding="{Binding AIProcessedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 5: Люди (Семья, Родственники, Друзья) -->
            <TabItem Header="👥 Люди (Семья, Родственники, Друзья)">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка: Добавление и Список людей -->
                    <Border Grid.Column="0" Background="#313244" CornerRadius="8" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="👤 Добавить человека в базу:" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>

                            <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Имя:" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewPersonName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="Категория (Семья, Родственники, Друзья, Знакомые, Коллеги):" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AvailablePersonCategories}" SelectedItem="{Binding SelectedPersonCategory}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Примечание (родство / статус):" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewPersonNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                    <Button Content="➕ Добавить человека" Command="{Binding AddPersonCommand}" 
                                            Padding="10,6" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="👥 Список персон (кликните для просмотра фото):" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="105"/>
                                        <DataGridTextColumn Header="Группа" Binding="{Binding Category}" Width="90"/>
                                        <DataGridTextColumn Header="Фото" Binding="{Binding PhotosCount}" Width="50"/>
                                        <DataGridTextColumn Header="Заметка" Binding="{Binding Notes}" Width="*"/>
                                        <DataGridTemplateColumn Header="Удал." Width="45">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑" 
                                                            Command="{Binding DataContext.DeletePersonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" 
                                                            Padding="3,1" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Правая колонка: Разметка лиц и Фотогалерея с миниатюрами -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="290"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Панель статуса, сброса и чистого пересканирования -->
                        <Border Grid.Row="0" Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Людей в базе (Семья + Друзья):" Foreground="#A6ADC8" FontSize="12"/>
                                        <TextBlock Text="{Binding People.Count}" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Найдено лиц людей на фото:" Foreground="#A6ADC8" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalKnownFacesCount}" FontWeight="Bold" FontSize="18" Foreground="#A6E3A1"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="▶ Сканировать новые фото" Command="{Binding StartFaceIndexingCommand}" 
                                                Padding="12,6" Margin="0,0,8,0" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" 
                                                ToolTip="Сканирует только новые фото. Существующие привязки людей НЕ сбрасываются."/>
                                        <Button Content="⏹ Стоп" Command="{Binding StopFaceIndexingCommand}" 
                                                Padding="10,6" Margin="0,0,8,0" Background="#585B70" Foreground="#FFFFFF" FontWeight="Bold"
                                                ToolTip="Приостановить процесс сканирования"/>
                                        <Button Content="🔄 Сбросить привязки" Command="{Binding ResetAllFaceAssignmentsCommand}" 
                                                Padding="10,6" Margin="0,0,8,0" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" 
                                                ToolTip="Отвязать все фото от людей (вернуть в неразмеченные)"/>
                                        <Button Content="🧹 Полная пересканировка" Command="{Binding ClearAndRescanFacesCommand}" 
                                                Padding="10,6" Background="#F9E2AF" Foreground="#11111B" FontWeight="Bold" 
                                                ToolTip="Очистить старую базу со следами природы и пересканировать всё нейросетью UltraFace с нуля"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ProgressBar Grid.Row="0" Height="6" Value="{Binding FaceIndexingProgress}" Maximum="100" 
                                                 Background="#11111B" Foreground="#89B4FA" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="1" Text="{Binding FaceIndexingStatusText}" Foreground="#CDD6F4" FontSize="11"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Блок 1: Неразмеченные лица («Кто это на фото?») -->
                        <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="🏷 Неразмеченные лица (укажите человека для альбома):" FontWeight="Bold" Foreground="#F9E2AF"/>
                                    <Button Grid.Column="1" Content="🔄 Обновить список" Command="{Binding RefreshFacesListCommand}" 
                                            Padding="8,2" Background="#313244" Foreground="#CDD6F4" FontSize="11"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding UnassignedFaces}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#313244" CornerRadius="6" Padding="8" Margin="0,0,10,0" Width="150">
                                                    <StackPanel>
                                                        <Border CornerRadius="4" ClipToBounds="True" Height="95" Background="#11111B" Margin="0,0,0,6">
                                                            <Image Source="{Binding CropThumbnailPath}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        
                                                        <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="#A6ADC8" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                                        <ComboBox ItemsSource="{Binding DataContext.People, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                                                                  DisplayMemberPath="Name" Margin="0,0,0,6" FontSize="11" Height="24"/>

                                                        <Button Content="✅ Это он/она" 
                                                                Command="{Binding DataContext.AssignFaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="4,3" Margin="0,0,0,4" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" FontSize="11"/>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="👤 Другой" ToolTip="Незнакомец / Другой человек"
                                                                    Command="{Binding DataContext.IgnoreFaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="2,2" Background="#585B70" Foreground="#FFFFFF" FontSize="10"/>
                                                            <Button Grid.Column="2" Content="❌ Не лицо" ToolTip="Это растение / предмет (удалить)"
                                                                    Command="{Binding DataContext.DeleteFalseFaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="2,2" Background="#F38BA8" Foreground="#11111B" FontSize="10"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Блок 2: Визуальная галерея фотографий выбранного человека -->
                        <Border Grid.Row="3" Background="#1E1E2E" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center">
                                        <Run Text="🖼 Альбом фотографий: "/>
                                        <Run Text="{Binding SelectedPerson.Name, FallbackValue='(выберите человека слева)'}" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="15"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding SelectedPersonPhotos.Count, Mode=OneWay}"/>
                                        <Run Text=" фото)"/>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1" Text="💡 Кликните «❌ Отвязать» на карточке фото, чтобы убрать его из альбома" 
                                               Foreground="#A6ADC8" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SelectedPersonPhotos}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#313244" CornerRadius="6" Padding="6" Margin="0,0,10,10" Width="150">
                                                    <StackPanel>
                                                        <!-- Миниатюра фотографии -->
                                                        <Border CornerRadius="4" ClipToBounds="True" Height="110" Background="#11111B" Margin="0,0,0,6">
                                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                                        </Border>

                                                        <!-- Имя файла -->
                                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" 
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}" Margin="0,0,0,2"/>

                                                        <!-- Дата -->
                                                        <TextBlock Text="{Binding FileCreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="10" Foreground="#A6ADC8" Margin="0,0,0,6"/>

                                                        <!-- Кнопка Отвязать с миниатюры -->
                                                        <Button Content="❌ Отвязать" 
                                                                Command="{Binding DataContext.UnassignPhotoFromPersonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="6,3" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" FontSize="11"
                                                                ToolTip="Убрать эту фотографию из альбома"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Нижняя строка состояния -->
        <Border Grid.Row="2" Background="#11111B" CornerRadius="4" Padding="10,5" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="#A6ADC8" FontSize="12"/>
        </Border>
    </Grid>
</Window>
