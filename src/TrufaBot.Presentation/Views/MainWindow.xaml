<Window x:Class="TrufaBot.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="../app.ico"
        Title="TrufaBot — Домашний медиа-сервер" Height="840" Width="1260"
        WindowStartupLocation="CenterScreen" Background="#181825" Foreground="#FFFFFF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#11111B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#585B70"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#11111B"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="BorderBrush" Value="#585B70"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="RowBackground" Value="#1E1E2E"/>
            <Setter Property="AlternatingRowBackground" Value="#252538"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#313244"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <Border Grid.Row="0" Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Токен Telegram бота:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding BotToken, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center" Margin="0,0,15,0"/>
                
                <Button Grid.Column="2" Content="▶ Запустить / Остановить бота" 
                         Command="{Binding ToggleBotCommand}" Padding="15,8" FontWeight="Bold" Margin="0,0,10,0"
                         Background="#89B4FA" Foreground="#11111B"/>
                
                <Button Grid.Column="3" Command="{Binding SyncAllSourcesCommand}" 
                        Padding="15,8" Foreground="#11111B" FontWeight="Bold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#A6E3A1"/>
                            <Setter Property="Content" Value="🔄 Синхронизировать NAS"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                    <Setter Property="Background" Value="#F9E2AF"/>
                                    <Setter Property="Content" Value="⏳ Идет сканирование..."/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Основные вкладки -->
        <TabControl Grid.Row="1" Background="#1E1E2E" BorderBrush="#313244">
            
            <!-- Вкладка 1: Журнал событий и Аудит -->
            <TabItem Header="📊 Журнал событий">
                <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" 
                          IsReadOnly="True" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="90"/>
                        <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="90"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="110"/>
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding UserIdentifier}" Width="130"/>
                        <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Вкладка 2: Источники файлов -->
            <TabItem Header="📁 Источники (NAS / Диски)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#313244" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Имя источника:" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewSourceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <TextBlock Grid.Column="2" Text="Путь (D:\ или \\NAS\share):" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding NewSourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <Button Grid.Column="4" Content="➕ Добавить источник" Command="{Binding AddSourceCommand}" 
                                    Padding="15,6" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Sources}" AutoGenerateColumns="False" 
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="Путь (Локальный / UNC)" Binding="{Binding RootPath}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Сетевой (NAS)" Binding="{Binding IsNetworkShare}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Включен" Binding="{Binding IsEnabled}" Width="80"/>
                            <DataGridTextColumn Header="Посл. скан" Binding="{Binding LastScannedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="150"/>
                            <DataGridTemplateColumn Header="Действия" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Вкл/Выкл" 
                                                    Command="{Binding DataContext.ToggleSourceEnabledCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" 
                                                    Padding="8,2" Margin="0,0,6,0" Background="#F9E2AF" Foreground="#11111B"/>
                                            <Button Content="🗑 Удалить" 
                                                    Command="{Binding DataContext.DeleteSourceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" 
                                                    Padding="8,2" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Пользователи и Права Доступа -->
            <TabItem Header="👥 Пользователи и Доступ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#313244" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Telegram ID:" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewTelegramUserId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <TextBlock Grid.Column="2" Text="Имя:" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding NewUserDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <Button Grid.Column="5" Content="➕ Добавить пользователя" Command="{Binding AddUserCommand}" 
                                    Padding="15,6" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="480"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1E1E2E" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="👥 Список пользователей (выберите для настройки):" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,8"/>
                                
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Telegram ID" Binding="{Binding TelegramUserId}" Width="110"/>
                                        <DataGridTextColumn Header="Имя" Binding="{Binding DisplayName}" Width="120"/>
                                        <DataGridCheckBoxColumn Header="Админ" Binding="{Binding IsAdmin}" Width="65"/>
                                        <DataGridCheckBoxColumn Header="Актив" Binding="{Binding IsActive}" Width="60"/>
                                        <DataGridTemplateColumn Header="Действия" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="⭐" ToolTip="Переключить права администратора"
                                                                Command="{Binding DataContext.ToggleUserAdminCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" 
                                                                Padding="5,1" Margin="0,0,3,0" Background="#F9E2AF" Foreground="#11111B"/>
                                                        <Button Content="Вкл/Выкл" 
                                                                Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" 
                                                                Padding="5,1" Margin="0,0,3,0" Background="#A6E3A1" Foreground="#11111B"/>
                                                        <Button Content="🗑" ToolTip="Удалить"
                                                                Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" 
                                                                Padding="5,1" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#1E1E2E" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,0,0,8">
                                    <Run Text="🔐 Права доступа для: "/>
                                    <Run Text="{Binding SelectedUser.DisplayName, FallbackValue='(не выбран)'}" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                </TextBlock>

                                <Border Grid.Row="1" Background="#313244" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Источник:" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedPermissionSource}"
                                                  DisplayMemberPath="Name" Margin="0,0,10,0"/>

                                        <TextBlock Grid.Column="2" Text="Папка:" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                        <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableFoldersForSelectedSource}" 
                                                  SelectedItem="{Binding SelectedFolderToGrant}" Margin="0,0,10,0"/>

                                        <Button Grid.Column="4" Content="[+] Разрешить" Command="{Binding AddPermissionForSelectedUserCommand}"
                                                Padding="10,4" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold"/>
                                    </Grid>
                                </Border>

                                <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedUserPermissions}" AutoGenerateColumns="False" 
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Источник (Диск/NAS)" Binding="{Binding StorageSource.Name}" Width="160"/>
                                        <DataGridTextColumn Header="Разрешенная папка" Binding="{Binding AllowedRelativePath}" Width="*"/>
                                        <DataGridTemplateColumn Header="Действие" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑 Отозвать" 
                                                            Command="{Binding DataContext.DeletePermissionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" 
                                                            Padding="6,2" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Вкладка 4: Локальный ИИ (LM Studio) -->
            <TabItem Header="🤖 Локальный ИИ (LM Studio)">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель подключения к LM Studio -->
                    <Border Grid.Row="0" Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Адрес LM Studio:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding AiServerUrl, UpdateSourceTrigger=PropertyChanged}" 
                                         VerticalAlignment="Center" Margin="0,0,15,0"/>

                                <Button Grid.Column="2" Content="🔌 Проверить связь с LM Studio" 
                                        Command="{Binding TestAiConnectionCommand}" Padding="15,6" FontWeight="Bold" Margin="0,0,15,0"
                                        Background="#89B4FA" Foreground="#11111B"/>

                                <CheckBox Grid.Column="3" Content="Включить обработку ИИ" IsChecked="{Binding IsAiEnabled}" 
                                          VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,15,0"/>
                            </Grid>

                            <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                                <TextBlock Text="{Binding AiConnectionStatus}" Foreground="#A6E3A1" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Панель управления индексацией и статистика -->
                    <Border Grid.Row="1" Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Статистика -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Всего файлов в архиве:" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock Text="{Binding AiTotalPhotos}" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Обработано ИИ:" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock Text="{Binding AiProcessedPhotos}" FontWeight="Bold" FontSize="18" Foreground="#A6E3A1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ожидает обработки:" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock Text="{Binding AiPendingPhotos}" FontWeight="Bold" FontSize="18" Foreground="#F9E2AF"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="▶ Запустить авто-тегирование" Command="{Binding StartAiIndexingCommand}" 
                                            Padding="15,8" Margin="0,0,10,0" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold"/>
                                    <Button Content="⏹ Остановить" Command="{Binding StopAiIndexingCommand}" 
                                            Padding="15,8" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Прогресс бар -->
                            <ProgressBar Grid.Row="1" Height="10" Value="{Binding AiIndexingProgress}" Maximum="100" 
                                         Background="#11111B" Foreground="#89B4FA" Margin="0,0,0,8"/>

                            <!-- Текстовый статус -->
                            <TextBlock Grid.Row="2" Text="{Binding AiIndexingStatusText}" Foreground="#CDD6F4" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- Недавно описанные фото -->
                    <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="✨ Недавно обработанные нейросетью файлы:" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,8"/>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding RecentAiProcessedItems}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="160"/>
                                    <DataGridTextColumn Header="Описание ИИ" Binding="{Binding AIDescription}" Width="*"/>
                                    <DataGridTextColumn Header="Теги" Binding="{Binding AITags}" Width="220"/>
                                    <DataGridTextColumn Header="Дата обработки" Binding="{Binding AIProcessedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Вкладка 5: Люди (Семья, Родственники, Друзья) -->
            <TabItem Header="👥 Люди (Семья, Родственники, Друзья)">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка: Добавление и Список людей -->
                    <Border Grid.Column="0" Background="#313244" CornerRadius="8" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="👤 Добавить человека в базу:" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>

                            <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="6" Padding="10" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Имя:" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewPersonName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                                    
                                    <TextBlock Text="Категория (Семья, Родственники, Друзья, Знакомые, Коллеги):" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AvailablePersonCategories}" SelectedItem="{Binding SelectedPersonCategory}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Примечание (родство / статус):" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding NewPersonNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                    <Button Content="➕ Добавить человека" Command="{Binding AddPersonCommand}" 
                                            Padding="10,6" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="👥 Список персон (кликните для просмотра фото):" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="100"/>
                                        <DataGridTextColumn Header="Группа" Binding="{Binding Category}" Width="85"/>
                                        <DataGridTextColumn Header="Обучено" Binding="{Binding SamplesCount}" Width="65"/>
                                        <DataGridTextColumn Header="Фото" Binding="{Binding PhotosCount}" Width="45"/>
                                        <DataGridTextColumn Header="Заметка" Binding="{Binding Notes}" Width="*"/>
                                        <DataGridTemplateColumn Header="Удал." Width="45">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🗑" 
                                                            Command="{Binding DataContext.DeletePersonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" 
                                                            Padding="3,1" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Правая колонка: Разметка лиц и Фотогалерея с миниатюрами -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="330"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Панель статуса, сброса и чистого пересканирования -->
                        <Border Grid.Row="0" Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Людей в базе (Семья + Друзья):" Foreground="#A6ADC8" FontSize="12"/>
                                        <TextBlock Text="{Binding People.Count}" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Найдено лиц людей на фото:" Foreground="#A6ADC8" FontSize="12"/>
                                        <TextBlock Text="{Binding TotalKnownFacesCount}" FontWeight="Bold" FontSize="18" Foreground="#A6E3A1"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="⚡ Обучить и найти всех по архиву" Command="{Binding AutoMatchAllFacesCommand}" 
                                                Padding="10,6" Margin="0,0,6,0" Background="#F9E2AF" Foreground="#11111B" FontWeight="Bold" 
                                                ToolTip="Обучает нейросеть SFace на подтвержденных вами образцах (1-3 фото на человека) и автоматически раскладывает все остальные фото архива по альбомам с добавлением имен в теги!"/>
                                        <Button Content="🧹 Перебрать весь архив" Command="{Binding PruneAllPeopleOutliersCommand}" 
                                                Padding="8,6" Margin="0,0,6,0" Background="#FAB387" Foreground="#11111B" FontWeight="Bold" 
                                                ToolTip="Вторичная переборка: отсеять сомнительные и ошибочно привязанные лица по всем альбомам обратно в «Неразмеченные»"/>
                                        <Button Content="🏷 Обновить теги на фото" Command="{Binding SyncPersonTagsCommand}" 
                                                Padding="8,6" Margin="0,0,6,0" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"
                                                ToolTip="Прописать имена людей в текстовые теги (AITags) всех фотографий для мгновенного поиска"/>
                                        <Button Content="🔄 Обновить отпечатки" Command="{Binding RecomputeEmbeddingsCommand}" 
                                                Padding="8,6" Margin="0,0,6,0" Background="#CBA6F7" Foreground="#11111B" FontWeight="Bold" 
                                                ToolTip="Пересчитать математические отпечатки SFace для всех найденных лиц"/>
                                        <Button Content="▶ Новые фото" Command="{Binding StartFaceIndexingCommand}" 
                                                Padding="8,6" Margin="0,0,6,0" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" 
                                                ToolTip="Сканирует только новые фото. Ваши существующие привязки НЕ сбрасываются."/>
                                        <Button Content="⏹ Стоп" Command="{Binding StopFaceIndexingCommand}" 
                                                Padding="8,6" Margin="0,0,6,0" Background="#585B70" Foreground="#FFFFFF" FontWeight="Bold"/>
                                        <Button Content="🔄 Сбросить" Command="{Binding ResetAllFaceAssignmentsCommand}" 
                                                Padding="8,6" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" 
                                                ToolTip="Отвязать все фото от людей"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ProgressBar Grid.Row="0" Height="6" Value="{Binding FaceIndexingProgress}" Maximum="100" 
                                                 Background="#11111B" Foreground="#89B4FA" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="1" Text="{Binding FaceIndexingStatusText}" Foreground="#CDD6F4" FontSize="11"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Блок 1: Очередь лиц для обучения / Фильтры по категориям -->
                        <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Верхняя панель: Переключение очередей, случайная выборка и обновление -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Заголовок текущей очереди -->
                                    <TextBlock Grid.Column="0" Text="{Binding CurrentFilterTitle}" FontWeight="Bold" Foreground="#F9E2AF" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <!-- Кнопки очередей -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Вкладка 1: Неразмеченные -->
                                        <Button Command="{Binding SetFilterUnassignedCommand}" ToolTip="Основная очередь лиц для обучения нейросети">
                                            <Button.Content>
                                                <TextBlock>
                                                    <Run Text="🏷 Неразмеченные ("/><Run Text="{Binding UnassignedCount, Mode=OneWay}"/><Run Text=")"/>
                                                </TextBlock>
                                            </Button.Content>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Padding" Value="9,4"/>
                                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                                    <Setter Property="Background" Value="#313244"/>
                                                    <Setter Property="Foreground" Value="#CDD6F4"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFilterUnassigned}" Value="True">
                                                            <Setter Property="Background" Value="#F9E2AF"/>
                                                            <Setter Property="Foreground" Value="#11111B"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Вкладка 2: Другие -->
                                        <Button Command="{Binding SetFilterIgnoredCommand}" ToolTip="Лица, скрытые как «Другой». Отсюда их можно восстановить обратно в обучение или подтвердить!">
                                            <Button.Content>
                                                <TextBlock>
                                                    <Run Text="👤 Другие ("/><Run Text="{Binding IgnoredFacesCount, Mode=OneWay}"/><Run Text=")"/>
                                                </TextBlock>
                                            </Button.Content>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Padding" Value="9,4"/>
                                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                                    <Setter Property="Background" Value="#313244"/>
                                                    <Setter Property="Foreground" Value="#CDD6F4"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFilterIgnored}" Value="True">
                                                            <Setter Property="Background" Value="#89B4FA"/>
                                                            <Setter Property="Foreground" Value="#11111B"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Вкладка 3: Не лица -->
                                        <Button Command="{Binding SetFilterFalseFacesCommand}" ToolTip="Фоны, предметы и растения, ошибочно принятые за лица. Если здесь оказалось реальное лицо — нажмите «Вернуть в очередь»!">
                                            <Button.Content>
                                                <TextBlock>
                                                    <Run Text="❌ Не лица ("/><Run Text="{Binding FalseFacesCount, Mode=OneWay}"/><Run Text=")"/>
                                                </TextBlock>
                                            </Button.Content>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Padding" Value="9,4"/>
                                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                                    <Setter Property="Background" Value="#313244"/>
                                                    <Setter Property="Foreground" Value="#CDD6F4"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFilterFalseFaces}" Value="True">
                                                            <Setter Property="Background" Value="#F38BA8"/>
                                                            <Setter Property="Foreground" Value="#11111B"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>

                                    <!-- Правая панель: Авто >85%, Случайная выборка и Обновление -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding ToggleAutoAssignHighConfidenceCommand}" 
                                                ToolTip="Автоматически отправлять лица с вероятностью >85% в альбом человека без необходимости кликать вручную">
                                            <Button.Content>
                                                <TextBlock Text="{Binding AutoAssignButtonText}"/>
                                            </Button.Content>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Padding" Value="9,4"/>
                                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                                    <Setter Property="Background" Value="#313244"/>
                                                    <Setter Property="Foreground" Value="#CDD6F4"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAutoAssignHighConfidenceEnabled}" Value="True">
                                                            <Setter Property="Background" Value="#A6E3A1"/>
                                                            <Setter Property="Foreground" Value="#11111B"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Command="{Binding ToggleRandomSampleModeCommand}" ToolTip="Случайная выборка (ORDER BY RANDOM) отбирает фото из разных годов и событий для лучшего обучения">
                                            <Button.Content>
                                                <TextBlock Text="{Binding RandomModeButtonText}"/>
                                            </Button.Content>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Padding" Value="9,4"/>
                                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                                    <Setter Property="Background" Value="#313244"/>
                                                    <Setter Property="Foreground" Value="#CDD6F4"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRandomSampleMode}" Value="True">
                                                            <Setter Property="Background" Value="#A6E3A1"/>
                                                            <Setter Property="Foreground" Value="#11111B"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="🔄 Обновить" Command="{Binding RefreshFacesListCommand}" 
                                                Padding="9,4" Background="#313244" Foreground="#CDD6F4" FontSize="11" FontWeight="SemiBold"
                                                ToolTip="Обновить карточки на экране"/>
                                    </StackPanel>
                                </Grid>

                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding UnassignedFaces}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#313244" CornerRadius="6" Padding="7" Margin="0,0,10,0" Width="155">
                                                    <StackPanel>
                                                        <!-- Превью вырезанного лица -->
                                                        <Border CornerRadius="4" ClipToBounds="True" Height="95" Background="#11111B" Margin="0,0,0,4"
                                                                ToolTip="{Binding BadgeText}">
                                                            <Image Source="{Binding CropThumbnailPath}" Stretch="UniformToFill"/>
                                                        </Border>

                                                        <!-- Бейдж предсказания ИИ с вероятностью в процентах (всегда видим) -->
                                                        <Border Background="{Binding BadgeBackground}" CornerRadius="3" Padding="4,3" Margin="0,0,0,4"
                                                                ToolTip="Вероятность совпадения лица с образцами в процентах">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" 
                                                                       Foreground="{Binding BadgeForeground}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </Border>

                                                        <!-- Имя файла -->
                                                        <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="#A6ADC8" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" ToolTip="{Binding FullImagePath}"/>

                                                        <!-- Выпадающий список людей (с авто-подстановкой наиболее вероятного) -->
                                                        <ComboBox ItemsSource="{Binding DataContext.People, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                                                                  DisplayMemberPath="Name" Margin="0,0,0,5" FontSize="11" Height="24"/>

                                                        <!-- Кнопка подтверждения: Это он/она -->
                                                        <Button Content="✅ Это он/она" 
                                                                Command="{Binding DataContext.AssignFaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="4,3" Margin="0,0,0,4" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" FontSize="11"
                                                                ToolTip="Подтвердить человека для альбома и добавить в обучение"/>

                                                        <!-- Кнопки для неразмеченных: Другой / Не лицо -->
                                                        <Grid Visibility="{Binding CanIgnoreOrDelete, Converter={StaticResource BoolToVisConverter}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="👤 Другой" ToolTip="Незнакомец / Другой человек (переместить во вкладку «Другие»)"
                                                                    Command="{Binding DataContext.IgnoreFaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="2,3" Background="#585B70" Foreground="#FFFFFF" FontSize="10"/>
                                                            <Button Grid.Column="2" Content="❌ Не лицо" ToolTip="Ложная детекция: фон, трава, предмет (переместить во вкладку «Не лица»)"
                                                                    Command="{Binding DataContext.DeleteFalseFaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="2,3" Background="#F38BA8" Foreground="#11111B" FontSize="10"/>
                                                        </Grid>

                                                        <!-- Кнопка для вкладок «Другие» и «Не лица»: вернуть обратно в очередь обучения -->
                                                        <Button Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisConverter}}"
                                                                Content="↩ Вернуть в очередь" 
                                                                Command="{Binding DataContext.RestoreFaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="3,3" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" FontSize="10"
                                                                ToolTip="Вернуть это лицо обратно в список неразмеченных"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Блок 2: Визуальная галерея фотографий выбранного человека -->
                        <Border Grid.Row="3" Background="#1E1E2E" CornerRadius="8" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center">
                                            <Run Text="🖼 Альбом фотографий: "/>
                                            <Run Text="{Binding SelectedPerson.Name, FallbackValue='(выберите человека слева)'}" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="15"/>
                                            <Run Text=" — Всего: "/>
                                            <Run Text="{Binding SelectedPerson.PhotosCount, FallbackValue='0'}" Foreground="#A6E3A1" FontWeight="Bold" FontSize="15"/>
                                            <Run Text=" фото"/>
                                            <Run Text=" (показано " Foreground="#A6ADC8" FontSize="12"/>
                                            <Run Text="{Binding SelectedPersonPhotos.Count, Mode=OneWay}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                                            <Run Text=")" Foreground="#A6ADC8" FontSize="12"/>
                                        </TextBlock>

                                        <Button Content="➕ Загрузить еще 50 фото" 
                                                Command="{Binding LoadMorePersonPhotosCommand}"
                                                Visibility="{Binding CanLoadMorePersonPhotos, Converter={StaticResource BoolToVisConverter}}"
                                                Padding="8,3" Margin="14,0,0,0"
                                                Background="#313244" Foreground="#89B4FA" FontWeight="Bold" FontSize="11"
                                                ToolTip="Подгрузить следующие 50 фотографий в галерею"/>

                                        <!-- Переключатель глобального режима: Фото целиком vs Лица крупно -->
                                        <Button Content="{Binding AlbumViewModeText}" 
                                                Command="{Binding ToggleAlbumViewModeCommand}"
                                                Padding="10,3" Margin="8,0,0,0"
                                                Background="#313244" Foreground="#F9E2AF" FontWeight="Bold" FontSize="11"
                                                ToolTip="Переключить показ между полными фотографиями и вырезанными лицами крупным планом для быстрой проверки"/>

                                        <!-- Вторичная переборка альбома выбранного человека -->
                                        <Button Content="🧹 Вторичная переборка" 
                                                Command="{Binding PruneSelectedPersonOutliersCommand}"
                                                Padding="10,3" Margin="8,0,0,0"
                                                Background="#FAB387" Foreground="#11111B" FontWeight="Bold" FontSize="11"
                                                ToolTip="Найти эталонный образ этого человека и выбросить в «Неразмеченные» все сомнительные фото (чужие лица или лица со слабым сходством)"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="💡 Кликните «❌ Отвязать» на карточке фото, чтобы убрать его из альбома" 
                                               Foreground="#A6ADC8" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <!-- Сообщение если у человека еще нет подтвержденных фото -->
                                        <TextBlock Text="У этого человека пока нет подтвержденных фотографий." 
                                                   Foreground="#A6ADC8" FontSize="13" FontStyle="Italic" Margin="10,30,0,30"
                                                   HorizontalAlignment="Center"
                                                   Visibility="{Binding HasNoSelectedPersonPhotos, Converter={StaticResource BoolToVisConverter}}"/>

                                        <ItemsControl ItemsSource="{Binding SelectedPersonPhotos}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#313244" CornerRadius="6" Padding="6" Margin="0,0,10,10" Width="155">
                                                        <StackPanel>
                                                            <!-- Контейнер изображения (БЕЗ ОБРЕЗКИ: Stretch=Uniform) -->
                                                            <Border CornerRadius="4" ClipToBounds="True" Height="115" Background="#11111B" Margin="0,0,0,6">
                                                                <Grid>
                                                                    <!-- Основное изображение: Stretch="Uniform" гарантирует, что фото ВСЕГДА видно целиком! -->
                                                                    <Image Source="{Binding DisplayThumbnailPath}" Stretch="Uniform" 
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           ToolTip="Дважды кликните, чтобы открыть оригинал фото">
                                                                        <Image.InputBindings>
                                                                            <MouseBinding Gesture="LeftDoubleClick" 
                                                                                          Command="{Binding DataContext.OpenFullPhotoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                          CommandParameter="{Binding}"/>
                                                                        </Image.InputBindings>
                                                                    </Image>

                                                                    <!-- Круглый аватар распознанного лица в правом нижнем углу (когда отображается полное фото) -->
                                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4"
                                                                            Width="38" Height="38" CornerRadius="19" BorderBrush="#89B4FA" BorderThickness="2"
                                                                            Background="#11111B" ClipToBounds="True"
                                                                            Cursor="Hand"
                                                                            ToolTip="Распознанное лицо человека на этом фото. Кликните, чтобы показать крупно!">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsShowingFaceCrop}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding HasFaceCrop}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Border.InputBindings>
                                                                            <MouseBinding Gesture="LeftClick" 
                                                                                          Command="{Binding DataContext.TogglePhotoViewModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                          CommandParameter="{Binding}"/>
                                                                        </Border.InputBindings>
                                                                        <Image Source="{Binding FaceCropThumbnailPath}" Stretch="UniformToFill"/>
                                                                    </Border>

                                                                    <!-- Значок 'Лицо' в левом верхнем углу, если сейчас включен крупный план лица -->
                                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                                            Background="#89B4FA" CornerRadius="3" Padding="4,1"
                                                                            Visibility="{Binding IsShowingFaceCrop, Converter={StaticResource BoolToVisConverter}}"
                                                                            ToolTip="Сейчас показано вырезанное лицо. Кликните переключатель внизу, чтобы увидеть всё фото.">
                                                                        <TextBlock Text="👤 Лицо" FontSize="9" FontWeight="Bold" Foreground="#11111B"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Имя файла -->
                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" 
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}" Margin="0,0,0,2"/>

                                                            <!-- Дата -->
                                                            <TextBlock Text="{Binding FileCreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="10" Foreground="#A6ADC8" Margin="0,0,0,5"/>

                                                            <!-- Кнопки управления карточкой: Отвязать и Переключить вид (Фото/Лицо) -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="4"/>
                                                                    <ColumnDefinition Width="32"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Button Grid.Column="0" Content="❌ Отвязать" 
                                                                        Command="{Binding DataContext.UnassignPhotoFromPersonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Padding="4,3" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" FontSize="11"
                                                                        ToolTip="Убрать эту фотографию из альбома"/>

                                                                <Button Grid.Column="2" Content="{Binding ToggleViewIcon}" 
                                                                        Command="{Binding DataContext.TogglePhotoViewModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Padding="0,3" Background="#313244" Foreground="#89B4FA" FontWeight="Bold" FontSize="12"
                                                                        ToolTip="{Binding ToggleViewTooltip}"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Нижняя панель догрузки фото -->
                                        <Border Margin="0,15,0,20" Padding="14,10" Background="#181825" CornerRadius="8" HorizontalAlignment="Center"
                                                Visibility="{Binding CanLoadMorePersonPhotos, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock VerticalAlignment="Center" Margin="0,0,15,0" Foreground="#CDD6F4" FontSize="13">
                                                    <Run Text="Показано "/>
                                                    <Run Text="{Binding SelectedPersonPhotos.Count, Mode=OneWay}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    <Run Text=" из "/>
                                                    <Run Text="{Binding SelectedPerson.PhotosCount, Mode=OneWay}" FontWeight="Bold" Foreground="#A6E3A1"/>
                                                    <Run Text=" фото этого человека"/>
                                                </TextBlock>
                                                <Button Content="➕ Загрузить еще 50 фото" 
                                                        Command="{Binding LoadMorePersonPhotosCommand}"
                                                        Padding="12,6" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" FontSize="12"
                                                        Margin="0,0,8,0"
                                                        ToolTip="Загрузить следующие 50 фотографий"/>
                                                <Button Content="⏩ Загрузить еще 200 фото" 
                                                        Command="{Binding LoadManyMorePersonPhotosCommand}"
                                                        Padding="12,6" Background="#CBA6F7" Foreground="#11111B" FontWeight="Bold" FontSize="12"
                                                        ToolTip="Загрузить следующие 200 фотографий"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Индикатор загрузки фото -->
                                        <ProgressBar IsIndeterminate="True" Height="4" Margin="30,10,30,10"
                                                     Visibility="{Binding IsLoadingPersonPhotos, Converter={StaticResource BoolToVisConverter}}"
                                                     Foreground="#89B4FA" Background="#11111B"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Нижняя строка состояния -->
        <Border Grid.Row="2" Background="#11111B" CornerRadius="4" Padding="10,5" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="#A6ADC8" FontSize="12"/>
        </Border>
    </Grid>
</Window>
