<Window x:Class="TrufaBot.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrufaBot — Домашний медиа-сервер" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#1E1E2E" Foreground="#CDD6F4">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <Border Grid.Row="0" Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Токен Telegram бота:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding BotToken, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center" Margin="0,0,15,0"/>
                
                <Button Grid.Column="2" Content="▶ Запустить / Остановить бота" 
                        Command="{Binding ToggleBotCommand}" Padding="15,8" FontWeight="Bold" Margin="0,0,10,0"
                        Background="#89B4FA" Foreground="#11111B"/>
                
                <Button Grid.Column="3" Content="🔄 Синхронизировать NAS" Command="{Binding SyncAllSourcesCommand}" 
                        Padding="15,8" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Вкладки приложения -->
        <TabControl Grid.Row="1" Background="#181825" BorderThickness="0">
            <!-- Вкладка 1: Журнал событий и Аудит -->
            <TabItem Header="📊 Журнал событий (Логи)">
                <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" 
                          IsReadOnly="True" Background="#181825" Foreground="#CDD6F4" 
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="90"/>
                        <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="90"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="110"/>
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding UserIdentifier}" Width="130"/>
                        <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Вкладка 2: Источники файлов -->
            <TabItem Header="📁 Источники (NAS / Диски)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#313244" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Имя источника:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewSourceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <TextBlock Grid.Column="2" Text="Путь (D:\ или \\NAS\share):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding NewSourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <Button Grid.Column="4" Content="➕ Добавить источник" Command="{Binding AddSourceCommand}" 
                                    Padding="15,6" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Sources}" AutoGenerateColumns="False" 
                              Background="#181825" Foreground="#CDD6F4" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Путь (Локальный / UNC)" Binding="{Binding RootPath}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Сетевой (NAS)" Binding="{Binding IsNetworkShare}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Включен" Binding="{Binding IsEnabled}" Width="80"/>
                            <DataGridTextColumn Header="Посл. скан" Binding="{Binding LastScannedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140"/>
                            <DataGridTemplateColumn Header="Действия" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Вкл/Выкл" 
                                                    Command="{Binding DataContext.ToggleSourceEnabledCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" 
                                                    Padding="8,2" Margin="0,0,6,0" Background="#F9E2AF" Foreground="#11111B"/>
                                            <Button Content="🗑 Удалить" 
                                                    Command="{Binding DataContext.DeleteSourceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" 
                                                    Padding="8,2" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Пользователи и Права -->
            <TabItem Header="👥 Пользователи и Доступ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#313244" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Telegram ID:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewTelegramUserId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <TextBlock Grid.Column="2" Text="Имя:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding NewUserDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <Button Grid.Column="5" Content="➕ Добавить пользователя" Command="{Binding AddUserCommand}" 
                                    Padding="15,6" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" AutoGenerateColumns="False" 
                              Background="#181825" Foreground="#CDD6F4" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Telegram ID" Binding="{Binding TelegramUserId}" Width="130"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding DisplayName}" Width="180"/>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="140"/>
                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Админ" Binding="{Binding IsAdmin}" Width="80"/>
                            <DataGridTextColumn Header="Дата добавления" Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}" Width="130"/>
                            <DataGridTemplateColumn Header="Действия" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Вкл/Выкл" 
                                                    Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" 
                                                    Padding="8,2" Margin="0,0,6,0" Background="#F9E2AF" Foreground="#11111B"/>
                                            <Button Content="🗑 Удалить" 
                                                    Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" 
                                                    Padding="8,2" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Нижняя строка состояния -->
        <StatusBar Grid.Row="2" Background="#11111B" Foreground="#A6ADC8" Padding="10,5" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" FontWeight="Bold"/>
        </StatusBar>
    </Grid>
</Window>
