<Window x:Class="TrufaBot.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrufaBot — Домашний медиа-сервер" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen" Background="#181825" Foreground="#FFFFFF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#11111B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#585B70"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#11111B"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="BorderBrush" Value="#585B70"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="RowBackground" Value="#1E1E2E"/>
            <Setter Property="AlternatingRowBackground" Value="#252538"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#313244"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель управления -->
        <Border Grid.Row="0" Background="#313244" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="Токен Telegram бота:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding BotToken, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center" Margin="0,0,15,0"/>
                
                <Button Grid.Column="2" Content="▶ Запустить / Остановить бота" 
                        Command="{Binding ToggleBotCommand}" Padding="15,8" FontWeight="Bold" Margin="0,0,10,0"
                        Background="#89B4FA" Foreground="#11111B"/>
                
                <Button Grid.Column="3" Content="🔄 Синхронизировать NAS" Command="{Binding SyncAllSourcesCommand}" 
                        Padding="15,8" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Вкладки приложения -->
        <TabControl Grid.Row="1" Background="#181825" BorderThickness="0">
            <!-- Вкладка 1: Журнал событий и Аудит -->
            <TabItem Header="📊 Журнал событий (Логи)">
                <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" 
                          IsReadOnly="True" Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="90"/>
                        <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="90"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="110"/>
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding UserIdentifier}" Width="130"/>
                        <DataGridTextColumn Header="Сообщение" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Вкладка 2: Источники файлов -->
            <TabItem Header="📁 Источники (NAS / Диски)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#313244" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Имя источника:" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewSourceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <TextBlock Grid.Column="2" Text="Путь (D:\ или \\NAS\share):" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding NewSourcePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <Button Grid.Column="4" Content="➕ Добавить источник" Command="{Binding AddSourceCommand}" 
                                    Padding="15,6" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Sources}" AutoGenerateColumns="False" 
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="160"/>
                            <DataGridTextColumn Header="Путь (Локальный / UNC)" Binding="{Binding RootPath}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Сетевой (NAS)" Binding="{Binding IsNetworkShare}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Включен" Binding="{Binding IsEnabled}" Width="80"/>
                            <DataGridTextColumn Header="Посл. скан" Binding="{Binding LastScannedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="150"/>
                            <DataGridTemplateColumn Header="Действия" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Вкл/Выкл" 
                                                    Command="{Binding DataContext.ToggleSourceEnabledCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" 
                                                    Padding="8,2" Margin="0,0,6,0" Background="#F9E2AF" Foreground="#11111B"/>
                                            <Button Content="🗑 Удалить" 
                                                    Command="{Binding DataContext.DeleteSourceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" 
                                                    Padding="8,2" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Пользователи и Права Доступа -->
            <TabItem Header="👥 Пользователи и Доступ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Добавление нового пользователя -->
                    <Border Grid.Row="0" Background="#313244" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Telegram ID:" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewTelegramUserId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <TextBlock Grid.Column="2" Text="Имя:" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding NewUserDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,15,0"/>
                            
                            <Button Grid.Column="5" Content="➕ Добавить пользователя" Command="{Binding AddUserCommand}" 
                                    Padding="15,6" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- Двухпанельный интерфейс: Список пользователей + Настройка прав -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="480"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая панель: Пользователи -->
                        <Border Grid.Column="0" Background="#1E1E2E" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="👥 Список пользователей (выберите для настройки):" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,8"/>
                                
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Telegram ID" Binding="{Binding TelegramUserId}" Width="110"/>
                                        <DataGridTextColumn Header="Имя" Binding="{Binding DisplayName}" Width="120"/>
                                        <DataGridCheckBoxColumn Header="Админ" Binding="{Binding IsAdmin}" Width="65"/>
                                        <DataGridCheckBoxColumn Header="Актив" Binding="{Binding IsActive}" Width="60"/>
                                        <DataGridTemplateColumn Header="Действия" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="⭐" ToolTip="Переключить права администратора"
                                                                Command="{Binding DataContext.ToggleUserAdminCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" 
                                                                Padding="5,1" Margin="0,0,4,0" Background="#F9E2AF" Foreground="#11111B"/>
                                                        <Button Content="Вкл/Выкл" 
                                                                Command="{Binding DataContext.ToggleUserActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" 
                                                                Padding="5,1" Margin="0,0,4,0" Background="#A6E3A1" Foreground="#11111B"/>
                                                        <Button Content="🗑" ToolTip="Удалить пользователя"
                                                                Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" 
                                                                Padding="5,1" Background="#F38BA8" Foreground="#11111B"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Правая панель: Настройка прав к папкам -->
                        <Border Grid.Column="2" Background="#1E1E2E" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок выбранного пользователя -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="🔒 Права доступа к папкам для пользователя:" FontWeight="Bold" FontSize="14" Foreground="#89B4FA"/>
                                    <TextBlock Margin="0,4,0,0" FontSize="13">
                                        <Run Text="Пользователь: " Foreground="#A6ADC8"/>
                                        <Run Text="{Binding SelectedUser.DisplayName, FallbackValue='(Не выбран)'}" FontWeight="Bold" Foreground="#A6E3A1"/>
                                        <Run Text=" | Telegram ID: " Foreground="#A6ADC8"/>
                                        <Run Text="{Binding SelectedUser.TelegramUserId, FallbackValue='—'}" Foreground="#F9E2AF"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Если админ - предупреждение о полном доступе -->
                                <Border Grid.Row="1" Background="#45475A" CornerRadius="4" Padding="8" Margin="0,0,0,10"
                                        Visibility="{Binding SelectedUser.IsAdmin, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="⭐ Этот пользователь — Администратор. У него есть полный доступ ко всем дискам, папкам и файлам." Foreground="#F9E2AF" FontWeight="SemiBold"/>
                                </Border>

                                <!-- Форма добавления нового разрешения -->
                                <Border Grid.Row="2" Background="#313244" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="➕ Назначить доступ к источнику / папке:" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Выбор источника -->
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedPermissionSource}" 
                                                      DisplayMemberPath="Name" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            
                                            <!-- Выбор папки -->
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFoldersForSelectedSource}" 
                                                      SelectedItem="{Binding SelectedFolderToGrant, Mode=TwoWay}"
                                                      IsEditable="True" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            
                                            <!-- Кнопка добавить -->
                                            <Button Grid.Column="2" Content="➕ Разрешить" Command="{Binding AddPermissionForSelectedUserCommand}" 
                                                    Padding="12,6" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Список назначенных прав -->
                                <Grid Grid.Row="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Разрешенные папки и источники:" FontWeight="Bold" Foreground="#CDD6F4" Margin="0,0,0,6"/>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedUserPermissions}" AutoGenerateColumns="False" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Источник" Binding="{Binding StorageSource.Name}" Width="140"/>
                                            <DataGridTextColumn Header="Разрешенный путь" Binding="{Binding AllowedRelativePath}" Width="*"/>
                                            <DataGridCheckBoxColumn Header="Вложенные" Binding="{Binding IsRecursive}" Width="90"/>
                                            <DataGridTemplateColumn Header="Действие" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="🗑 Отозвать" 
                                                                Command="{Binding DataContext.DeletePermissionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}" 
                                                                Padding="6,2" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Нижняя строка состояния -->
        <StatusBar Grid.Row="2" Background="#11111B" Foreground="#A6ADC8" Padding="10,5" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" FontWeight="Bold"/>
        </StatusBar>
    </Grid>
</Window>
